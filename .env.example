VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Never expose a service-role key in VITE_ variables.

# Mobile money adapter mode. Unset or "sandbox" = browser sandbox (persists
# to localStorage). "live" = the mock adapter throws at module load time
# because it cannot process real payments; production must swap
# walletService's adapter for one that calls a server-side Edge Function.
# VITE_MOBILE_MONEY_MODE=sandbox
