VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Never expose a service-role key in VITE_ variables.

# Mobile money adapter mode. Unset or "sandbox" = browser sandbox (persists
# to localStorage). "live" = requires VITE_MOBILE_MONEY_ENDPOINT and routes
# payments through a server-side Edge Function; the adapter throws if "live"
# is set without an endpoint.
# VITE_MOBILE_MONEY_MODE=sandbox
# VITE_MOBILE_MONEY_ENDPOINT=
