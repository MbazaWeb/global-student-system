# Supabase project URL and publishable (anon) key. Both are required for sign-in and registration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Never put a service-role key in VITE_ variables. They are bundled into the browser.

# Mobile money adapter mode. Unset or "sandbox" = browser sandbox (persists to localStorage).
# "live" = every payment call is rejected, because the sandbox cannot process real money.
# Production must use an adapter that calls a server-side Edge Function.
# VITE_MOBILE_MONEY_MODE=sandbox
